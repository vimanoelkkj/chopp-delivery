exports[`P3: approved section defaults captured before adaptation > about: unchanged markup without editorial props 1`] = `"<section id="sobre" class="_section_a9e2bc" aria-labelledby="sobre-title"><div class="_container_4ea6fc _inner_a9e2bc"><div class="_copy_a9e2bc"><p class="_eyebrow_a9e2bc">04 • Origem &amp; Compromisso</p><h2 id="sobre-title" class="_title_a9e2bc">O Chopp Como Centro da Sua Celebração</h2><p class="_lead_a9e2bc">Não entregamos latas nem garrafas: somos especialistas dedicados na cadeia do barril de chopp. Mantemos nossa câmara fria estritamente controlada para que a carbonatação, a espuma cremosa e a frescura de cada cervejaria cheguem intactas ao seu evento.</p><p class="_text_a9e2bc">Fundado em São João del-Rei, o Chopp Delivery une a pontualidade da entrega local com equipamentos profissionais de refrigeração para fazer cada brinde memorável.</p></div><div class="_mediaCard_a9e2bc"><img src="/images/kegs/keg-studio-30l.jpg" alt="Barris de Chopp em Aço Escovado na Câmara Fria" class="_photo_a9e2bc" loading="lazy"/><div class="_captionRow_a9e2bc"><span>Barris em aço inoxidável padrão alimentício</span><span class="_badge_a9e2bc">• Higienização rigorosa</span></div></div></div></section>"`;

exports[`P3: approved section defaults captured before adaptation > barrels: unchanged markup without editorial props 1`] = `"<section id="barris" class="_section_6787f8" aria-labelledby="barris-title"><div class="_container_4ea6fc"><div class="_header_6787f8"><p class="_eyebrow_6787f8">01 • Vitrine Assinatura</p><h2 id="barris-title" class="_title_6787f8">Escolha seu Barril em 3D</h2><p class="_lead_6787f8">Navegue pelos barris reais da nossa câmara fria. Arraste horizontalmente ou use as setas para inspecionar detalhes, litragens e valores de cada cervejaria.</p></div><p role="status" class="_statusMessage_6787f8">Carregando vitrine de barris…</p><div class="_specsGrid_6787f8"><div class="_specCard_6787f8"><span class="_specValue_6787f8">30 Litros</span><span class="_specLabel_6787f8">Rende aprox. 60 copos de 500ml (ou 100 copos de 300ml)</span></div><div class="_specCard_6787f8"><span class="_specValue_6787f8">50 Litros</span><span class="_specLabel_6787f8">Rende aprox. 100 copos de 500ml (ou 160 copos de 300ml)</span></div><div class="_specCard_6787f8"><span class="_specValue_6787f8">100% Inclusos</span><span class="_specLabel_6787f8">Chopeira elétrica profissional 110V/220V e cilindro de CO2 regulado</span></div><div class="_specCard_6787f8"><span class="_specValue_6787f8">São João del-Rei</span><span class="_specLabel_6787f8">Entrega, instalação técnica no local e recolhimento sem taxa oculta</span></div></div></div></section>"`;

exports[`P3: approved section defaults captured before adaptation > catalog: unchanged markup without editorial props 1`] = `"<section id="chopes" class="_section_0a122b" aria-labelledby="chopes-title"><div class="_container_4ea6fc _inner_0a122b"><div class="_top_0a122b"><div class="_headerCopy_0a122b"><p class="_eyebrow_0a122b">02 • Catálogo Real</p><h2 id="chopes-title" class="_title_0a122b">Nossos Chopes &amp; Litragens</h2><p class="_note_0a122b">Consulte os valores dos barris de 30 e de 50 litros.</p></div></div><div><p role="status">Carregando catálogo…</p></div></div></section>"`;

exports[`P3: approved section defaults captured before adaptation > contact: unchanged markup without editorial props 1`] = `"<section id="contato" class="_section_c166a5" aria-labelledby="contato-title"><div class="_container_4ea6fc _inner_c166a5"><div class="_row_c166a5"><h2 id="contato-title" class="_title_c166a5">Bora<br/><span class="_accent_c166a5">pedir?</span></h2><div class="_action_c166a5"><p class="_text_c166a5">Conte o que precisa e a gente responde com as opções e os valores.</p><span class="_wrap_020b62"><button type="button" aria-describedby="_R_19_" class="_button_383ce1 _gold_383ce1 _lg_383ce1">Chamar no WhatsApp</button><span id="_R_19_" role="status" class="_notice_020b62 _below_020b62"></span></span></div></div><footer class="_footer_c166a5"><p class="_notice_b24f4f _footer_b24f4f" data-testid="age-notice-footer"><span class="_badge_b24f4f" aria-hidden="true">18+</span><span>Venda proibida para menores de 18 anos. Beba com moderação.</span></p><p class="_meta_c166a5"><span>São João del-Rei e Região, MG</span><span>Chopp Delivery Delegas</span></p></footer></div></section>"`;

exports[`P3: approved section defaults captured before adaptation > faq: unchanged markup without editorial props 1`] = `"<section id="faq" class="_section_cf2777" aria-labelledby="faq-title"><div class="_container_4ea6fc _inner_cf2777"><div class="_heading_54bb87"><p class="_eyebrow_54bb87">05 · Dúvidas</p><h2 id="faq-title" class="_title_54bb87">Perguntas <br class="_break_ac5de4"/>frequentes</h2></div><div class="_list_29de34"><div class="_item_29de34"><h3 class="_heading_29de34"><button type="button" id="_R_2_-tamanhos-button" class="_trigger_29de34" aria-expanded="true" aria-controls="_R_2_-tamanhos-panel"><span>Qual a diferença entre o barril de 30 e o de 50 litros?</span><span class="_sign_29de34" aria-hidden="true">−</span></button></h3><section id="_R_2_-tamanhos-panel" aria-labelledby="_R_2_-tamanhos-button"><p class="_answer_29de34">Só o volume. O barril de 30 L rende cerca de 60 copos de 500 ml (ou 100 de 300 ml), ideal para grupos menores. O de 50 L rende cerca de 100 copos de 500 ml (ou 160 de 300 ml), recomendado para festas e eventos maiores.</p></section></div><div class="_item_29de34"><h3 class="_heading_29de34"><button type="button" id="_R_2_-entrega-button" class="_trigger_29de34" aria-expanded="false" aria-controls="_R_2_-entrega-panel"><span>Vocês entregam no meu bairro?</span><span class="_sign_29de34" aria-hidden="true">+</span></button></h3><section id="_R_2_-entrega-panel" aria-labelledby="_R_2_-entrega-button" hidden=""><p class="_answer_29de34">Entregamos em São João del-Rei e região. A confirmação para o seu bairro, além de prazo, agendamento de horário e eventual taxa de entrega, é realizada diretamente no atendimento via WhatsApp.</p></section></div><div class="_item_29de34"><h3 class="_heading_29de34"><button type="button" id="_R_2_-instalacao-button" class="_trigger_29de34" aria-expanded="false" aria-controls="_R_2_-instalacao-panel"><span>O que preciso informar para a instalação?</span><span class="_sign_29de34" aria-hidden="true">+</span></button></h3><section id="_R_2_-instalacao-panel" aria-labelledby="_R_2_-instalacao-button" hidden=""><p class="_answer_29de34">Avise se há escadas no local e se a tomada é 110 V ou 220 V.</p></section></div><div class="_item_29de34"><h3 class="_heading_29de34"><button type="button" id="_R_2_-pagamento-button" class="_trigger_29de34" aria-expanded="false" aria-controls="_R_2_-pagamento-panel"><span>Quais as formas de pagamento?</span><span class="_sign_29de34" aria-hidden="true">+</span></button></h3><section id="_R_2_-pagamento-panel" aria-labelledby="_R_2_-pagamento-button" hidden=""><p class="_answer_29de34">As condições e opções de pagamento são informadas mediante confirmação comercial do estabelecimento no atendimento.</p></section></div></div></div></section>"`;

exports[`P3: approved section defaults captured before adaptation > hero: unchanged markup without editorial props 1`] = `"<link rel="preload" as="image" href="/images/kegs/keg-hero-50l.jpg"/><section class="_hero_33842a" aria-labelledby="hero-title"><div class="_container_4ea6fc _grid_33842a"><div class="_leftCol_33842a"><div class="_eyebrow_33842a"><span class="_eyebrowDot_33842a" aria-hidden="true"></span><span>Chopp Delivery Especial • Barris 30L &amp; 50L</span></div><h1 id="hero-title" class="_title_33842a">O melhor do chopp.<br/><span class="_accentGradient_33842a">Direto para o seu evento.</span></h1><p class="_text_33842a">Barris em aço inox escovado das melhores cervejarias artesanais e tradicionais. Receba com chopeira elétrica regulada pronta para servir. Entrega e instalação profissional em São João del-Rei e região.</p><div class="_actions_33842a"><span class="_wrap_020b62"><button type="button" aria-describedby="_R_1h_" class="_button_383ce1 _gold_383ce1">Pedir no WhatsApp</button><span id="_R_1h_" role="status" class="_notice_020b62 _below_020b62"></span></span><a href="#barris" class="_button_383ce1 _outline_383ce1">Explorar Barris 3D</a><a href="#chopes" class="_button_383ce1 _outline_383ce1">Ver Tabela &amp; Preços</a></div><div class="_trustBadges_33842a"><div><div class="_badgeValue_33842a">30L &amp; 50L</div><div class="_badgeLabel_33842a">Barris de aço inox escovado</div></div><div><div class="_badgeValue_33842a">100% Instalação</div><div class="_badgeLabel_33842a">Chopeira elétrica 110V/220V inclusa</div></div><div><div class="_badgeValue_33842a">Zero Retirada</div><div class="_badgeLabel_33842a">Entregamos e recolhemos no local</div></div></div><p class="_notice_b24f4f _hero_b24f4f" data-testid="age-notice-hero"><span class="_badge_b24f4f" aria-hidden="true">18+</span><span>Venda proibida para menores de 18 anos. Beba com moderação.</span></p></div><div class="_heroVisual_33842a"><img src="/images/kegs/keg-hero-50l.jpg" alt="Barril de Chopp de Inox Escovado 50 Litros com Iluminação Cinematográfica" class="_kegImg_33842a" loading="eager"/><div class="_floatingPill_33842a"><div><span class="_pillLabel_33842a">Protagonista</span><p class="_pillTitle_33842a">Barris em Aço Inox</p><p class="_pillSub_33842a">Entrega e instalação profissional inclusas</p></div></div></div></div></section>"`;

exports[`P3: approved section defaults captured before adaptation > how: unchanged markup without editorial props 1`] = `"<section id="como" class="_section_e90a8c" aria-labelledby="como-title"><div class="_container_4ea6fc _inner_e90a8c"><div class="_header_e90a8c"><p class="_eyebrow_e90a8c">03 • Sem Complicações</p><h2 id="como-title" class="_title_e90a8c">Como Funciona a Entrega</h2><p class="_lead_e90a8c">Operação exclusivamente por delivery. Levamos o barril gelado, conectamos a chopeira elétrica e deixamos pronta para o brinde.</p></div><ol class="_stepsGrid_e90a8c"><li class="_stepCard_e90a8c"><span class="_stepNumber_e90a8c" aria-hidden="true">01</span><h3 class="_stepTitle_e90a8c">Escolha o Chopp</h3><p class="_stepText_e90a8c">Selecione o estilo e a cervejaria desejada, definindo entre 30L ou 50L conforme o número de convidados.</p></li><li class="_stepCard_e90a8c"><span class="_stepNumber_e90a8c" aria-hidden="true">02</span><h3 class="_stepTitle_e90a8c">Dados &amp; Tomada</h3><p class="_stepText_e90a8c">Informe data, horário, endereço do evento e se a tomada disponível é 110V ou 220V para a chopeira.</p></li><li class="_stepCard_e90a8c"><span class="_stepNumber_e90a8c" aria-hidden="true">03</span><h3 class="_stepTitle_e90a8c">Instalação Inclusa</h3><p class="_stepText_e90a8c">Nossa equipe posiciona o barril, liga a chopeira elétrica profissional, calibra o CO2 e deixa tudo pronto.</p></li><li class="_stepCard_e90a8c"><span class="_stepNumber_e90a8c" aria-hidden="true">04</span><h3 class="_stepTitle_e90a8c">Aproveite o Chopp</h3><p class="_stepText_e90a8c">Chopp sempre gelado do primeiro ao último copo. Após o evento, nós recolhemos o equipamento sem complicações.</p></li></ol></div></section>"`;

exports[`P3: approved section defaults captured before adaptation > promo: unchanged markup without editorial props 1`] = `"<section class="_section_567a08" aria-labelledby="promo-title"><div class="_container_4ea6fc _inner_567a08"><div class="_copy_567a08"><p class="_eyebrow_567a08">Happy hour · promoções</p><h2 id="promo-title" class="_title_567a08">Condições Especiais para Eventos</h2><p class="_text_567a08">Chopeira elétrica profissional inclusa e instalação técnica em São João del-Rei e região. Consulte pacotes e datas para seu evento via WhatsApp.</p></div><span class="_wrap_020b62"><button type="button" aria-describedby="_R_2_" class="_button_383ce1 _dark_383ce1 _lg_383ce1">Quero essa</button><span id="_R_2_" role="status" class="_notice_020b62 _below_020b62"></span></span></div></section>"`;

exports[`P3: approved section defaults captured before adaptation > ticker: unchanged markup without editorial props 1`] = `"<div class="_ticker_674e50"><div class="_track_674e50"><ul class="_row_674e50"><li class="_item_674e50">Chope gelado</li><li class="_item_674e50">Barril 30 L</li><li class="_item_674e50">Barril 50 L</li><li class="_item_674e50">100% Delivery</li><li class="_item_674e50">Instalação inclusa</li></ul><ul class="_row_674e50" aria-hidden="true"><li class="_item_674e50">Chope gelado</li><li class="_item_674e50">Barril 30 L</li><li class="_item_674e50">Barril 50 L</li><li class="_item_674e50">100% Delivery</li><li class="_item_674e50">Instalação inclusa</li></ul></div></div>"`;
