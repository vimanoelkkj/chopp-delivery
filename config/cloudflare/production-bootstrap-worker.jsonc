{
  // Estado versionado = DESARMADO. O armamento acontece só na janela supervisionada, por cópia
  // temporária fora do repositório (docs/production-bootstrap-runbook.md). Nenhum id real aqui.
  "name": "chopp-production-bootstrap",
  "main": "../../server/auth/production-bootstrap-worker.ts",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "triggers": {
    "crons": []
  },
  "d1_databases": [
    {
      "binding": "DELEGAS_DB",
      "database_name": "chopp-delivery-prod-db",
      "database_id": "REPLACE_WITH_PRODUCTION_D1_ID"
    }
  ],
  "vars": {
    "PRODUCTION_BOOTSTRAP_ENVIRONMENT": "production",
    "PRODUCTION_BOOTSTRAP_ENABLED": "disabled"
  }
}
