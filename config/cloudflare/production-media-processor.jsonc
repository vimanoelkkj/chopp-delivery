{
  // Gate do processador FECHADO por padrão (deploy inicial = disabled). A variante aberta é production-media-processor-open.jsonc.
  // Ver docs/production-media-enablement.md.
  // Worker privado: só é chamado pelo binding de serviço CMS_MEDIA_PROCESSOR do Pages de produção.
  // Não tem D1, R2, rotas, cron, workers.dev nem URLs de preview.
  "name": "chopp-cms-image-processor-production",
  "main": "../../server/cms/image-worker.mjs",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "triggers": {
    "crons": []
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "CMS_MEDIA_PROCESSOR_ENABLED": "disabled"
  }
}
